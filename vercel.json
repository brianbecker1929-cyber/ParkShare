{
  "redirects": [
    {
      "source": "/discover/events",
      "destination": "/discover/festivals",
      "permanent": true
    },
    {
      "source": "/discover/events/",
      "destination": "/discover/festivals",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "legal",
          "value": "terms"
        }
      ],
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "legal",
          "value": "privacy"
        }
      ],
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "legal",
          "value": "payments"
        }
      ],
      "destination": "/payments",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "legal",
          "value": "liability"
        }
      ],
      "destination": "/liability",
      "permanent": true
    }
  ],
